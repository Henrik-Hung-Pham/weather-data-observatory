# Environment Configuration for Data Observatory
# Copy this file to .env and fill in your values

# =============================================================================
# API Configuration
# =============================================================================
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Cities to fetch weather data for (comma-separated)
WEATHER_CITIES=London,New York,Tokyo,Sydney,Paris

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=observatory
POSTGRES_USER=observatory
POSTGRES_PASSWORD=observatory_secret

# =============================================================================
# AWS / LocalStack Configuration
# =============================================================================
# For local development with LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# S3 Bucket for data lake
S3_BUCKET_NAME=data-observatory

# =============================================================================
# Data Lake Paths (within S3 bucket)
# =============================================================================
BRONZE_PATH=bronze/weather
SILVER_PATH=silver/weather
GOLD_PATH=gold/weather

# Date partition layout: "hive" (year=YYYY/month=MM/day=DD — enables partition
# pruning in Athena/Glue/Spark) or "plain" (YYYY/MM/DD)
PARTITION_STYLE=hive

# =============================================================================
# Pipeline Configuration
# =============================================================================
# Ingestion interval in minutes
INGESTION_INTERVAL_MINUTES=60

# Quality gate behavior: "warn" or "block"
QUALITY_GATE_MODE=block

# =============================================================================
# Dashboard Configuration
# =============================================================================
STREAMLIT_PORT=8501
