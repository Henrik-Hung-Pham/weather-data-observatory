# Environment Configuration for Data Observatory
# Copy this file to .env and fill in your values

# =============================================================================
# API Configuration
# =============================================================================
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Cities to fetch weather data for (comma-separated)
WEATHER_CITIES=London,New York,Tokyo,Sydney,Paris

# Resilience for transient API failures (429/5xx). Retries use exponential
# backoff: wait = backoff_factor * (2 ** (attempt - 1)) seconds.
API_MAX_RETRIES=3
API_BACKOFF_FACTOR=1.0
API_TIMEOUT_SECONDS=30

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=observatory
POSTGRES_USER=observatory
POSTGRES_PASSWORD=observatory_secret

# =============================================================================
# AWS / LocalStack Configuration
# =============================================================================
# For local development with LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# S3 Bucket for data lake
S3_BUCKET_NAME=data-observatory

# =============================================================================
# Data Lake Paths (within S3 bucket)
# =============================================================================
BRONZE_PATH=bronze/weather
SILVER_PATH=silver/weather
GOLD_PATH=gold/weather

# =============================================================================
# Pipeline Configuration
# =============================================================================
# Ingestion interval in minutes
INGESTION_INTERVAL_MINUTES=60

# Quality gate behavior: "warn" or "block"
QUALITY_GATE_MODE=block

# Self-healing: route records that fail Silver cleaning to a quarantine
# prefix instead of dropping them (the run continues with the valid subset).
QUARANTINE_ENABLED=true

# =============================================================================
# Alerting
# =============================================================================
# Send a Slack message when a run fails or is blocked by a quality gate.
ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=

# =============================================================================
# Dashboard Configuration
# =============================================================================
STREAMLIT_PORT=8501

# =============================================================================
# Observability / Logging
# =============================================================================
# Root log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log output format: "text" (human-readable) or "json" (structured, for
# aggregation in CloudWatch/Loki/Datadog)
LOG_FORMAT=text
