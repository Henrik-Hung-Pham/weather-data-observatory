                "column": "city"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_to_exist",
            "kwargs": {
                "column": "temperature_celsius"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_to_exist",
            "kwargs": {
                "column": "humidity"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_to_exist",
            "kwargs": {
                "column": "timestamp"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "city"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "temperature_celsius"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "country"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "temperature_celsius",
