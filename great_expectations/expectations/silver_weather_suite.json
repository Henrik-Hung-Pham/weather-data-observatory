                "max_value": 100
            },
            "meta": {
                "notes": "Humidity is a percentage"
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "pressure",
                "min_value": 800,
                "max_value": 1200
            },
            "meta": {
                "notes": "Atmospheric pressure in hPa"
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "wind_speed",
                "min_value": 0,
