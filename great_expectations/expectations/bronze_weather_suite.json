{
    "expectation_suite_name": "bronze_weather_suite",
    "expectations": [
        {
            "expectation_type": "expect_table_columns_to_match_set",
            "kwargs": {
                "column_set": [
                    "city",
                    "country",
                    "temperature_kelvin",
                    "temperature_celsius",
                    "feels_like_celsius",
                    "humidity",
                    "pressure",
                    "wind_speed",
                    "wind_direction",
                    "weather_condition",
                    "weather_description",
                    "clouds_percentage",
                    "visibility",
                    "timestamp",
                    "sunrise",
                    "sunset",
                    "ingested_at"
                ],
                "exact_match": false
            },
            "meta": {
                "notes": "Bronze layer should have all raw weather fields"
            }
        },
        {
            "expectation_type": "expect_column_to_exist",
            "kwargs": {
                "column": "city"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_to_exist",
            "kwargs": {
                "column": "timestamp"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "city"
            },
            "meta": {
                "notes": "City is required for all weather records"
            }
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "timestamp"
            },
            "meta": {}
        },
        {
            "expectation_type": "expect_table_row_count_to_be_between",
            "kwargs": {
                "min_value": 1
            },
            "meta": {
                "notes": "Ensure we have at least one record"
            }
        }
    ],
    "meta": {
        "notes": "Bronze layer expectations - minimal validation for raw data"
    }
}